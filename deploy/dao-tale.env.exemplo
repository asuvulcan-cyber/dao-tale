# Dao Tale — configuração do serviço hospedado (doc 13 §5).
#
#     sudo install -d -m 0700 /etc/dao-tale
#     sudo install -m 0600 deploy/dao-tale.env.exemplo /etc/dao-tale/dao-tale.env
#     sudo nano /etc/dao-tale/dao-tale.env     # troque o domínio
#
# NUNCA versione o arquivo preenchido: ele é lido pelo systemd, não pelo git.
# A SENHA NÃO MORA AQUI — ela é definida por `npm run senha` e guardada com
# hash em /var/lib/dao-tale/auth.json (0600).

# Liga o modo hospedado: exige sessão em toda a API e allowlist de domínio.
# Sem esta linha, o app roda como sempre rodou (local, loopback, sem senha).
DAO_TALE_MODO=hospedado

# Domínio(s) por onde o app é acessado. Host/Origin fora desta lista → 403.
DAO_TALE_HOST_PUBLICO=tale.exemplo.com

# Dados persistentes: banco, backups, credenciais.json, auth.json, sessao.chave.
# Bate com o StateDirectory da unit systemd.
DAO_TALE_DIR=/var/lib/dao-tale

# Porta local; quem escuta na internet é o Caddy (127.0.0.1 só).
DAO_TALE_PORTA=8317

# Opcional — segredo de assinatura das sessões. Se ficar de fora, é gerado uma
# vez em /var/lib/dao-tale/sessao.chave (0600), que é o recomendado.
# Trocar este valor desconecta todos os aparelhos.
# DAO_TALE_SESSAO_SEGREDO=

# Opcional — quantos backups manter (padrão 10).
# DAO_TALE_BACKUPS_MANTER=10
